{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luxury-travel",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-06-24",
  "alias": {
    "virtual:react-router/server-build": "./dist/server/index.js"
  },
  "assets": {
    "directory": "./dist/client"
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFyZ1XmI1cBbY53p"
  },
  "ratelimits": [
    {
      "name": "INQUIRY_RATE_LIMITER",
      "namespace_id": "2026110301",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "r2_buckets": [{ "binding": "RESORT_PHOTOS", "bucket_name": "premier-resort-photos" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luxury-travel-db",
      "database_id": "c62b3abe-a3ee-4326-be96-f78e1ac05c62"
    }
  ]
}
